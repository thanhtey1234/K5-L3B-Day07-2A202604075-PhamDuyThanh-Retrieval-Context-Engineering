# Keep the real .env local. Never paste keys in a trace or a report.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free
OPENROUTER_REQUESTS_PER_MINUTE=10
OPENROUTER_DAILY_REQUEST_BUDGET=45
OPENROUTER_TIMEOUT_SECONDS=120
# Groq alternative: select LLM_PROVIDER=groq explicitly. Confirm account Free tier
# in the dashboard before setting GROQ_FREE_TIER_CONFIRMED=true.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FREE_TIER_CONFIRMED=false
GROQ_DAILY_REQUEST_BUDGET=900
GROQ_DAILY_TOKEN_BUDGET=180000
GROQ_TOKENS_PER_MINUTE=7200
GROQ_MAX_OUTPUT_TOKENS=1024
# Existing Day 6 database. The application only SELECTs from its chunks table.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
DAY6_STRATEGY=strategy_b
DAY6_EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
DAY6_EMBEDDING_REVISION=
ADVANCED_EMBEDDING_MODEL=BAAI/bge-m3
ADVANCED_EMBEDDING_REVISION=
RAG_DEVICE=cpu
RAG_WORK_DIR=work
